{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "strum-and-spruce.vercel.app"
        }
      ],
      "destination": "https://strumandspruce.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)/",
      "destination": "/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/reference-hub", "destination": "/reference-hub.html" },
    { "source": "/lessons/anatomy", "destination": "/lessons/anatomy.html" },
    { "source": "/lessons/chords", "destination": "/lessons/chords.html" },
    { "source": "/lessons/strumming", "destination": "/lessons/strumming.html" },
    { "source": "/lessons/songs", "destination": "/lessons/songs.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}